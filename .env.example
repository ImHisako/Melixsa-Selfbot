TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash
# WebNowPlaying Custom Adapter port (optional; default: 8976).
WEBNOWPLAYING_PORT=8976
# Your GeoSeeer API key for geosint (optional).
GEOSEEER_API_KEY=

# LRCLIB: your project URL or contact email, included in the User-Agent.
LRCLIB_CLIENT_CONTACT=

# OSINT: include adult-category sites in username scans (0 = excluded).
OSINT_INCLUDE_ADULT=0
